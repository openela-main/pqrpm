 		hdrblob *sigblobp, hdrblob *blobp, char **emsg)
 {
@@ -210,6 +222,7 @@ static int rpmpkgVerifySigs(rpmKeyring keyring, int vfylevel, rpmVSFlags flags,
     char *msg = NULL;
     struct vfydata_s vd = { .seen = 0,
 			    .verbose = rpmIsVerbose(),
+			    .rc = 0,
     };
     int rc;
     struct rpmvs_s *vs = rpmvsCreate(vfylevel, flags, keyring);
@@ -221,7 +234,9 @@ static int rpmpkgVerifySigs(rpmKeyring keyring, int vfylevel, rpmVSFlags flags,
     if (rc)
 	goto exit;
 
-    rc = rpmvsVerify(vs, RPMSIG_VERIFIABLE_TYPE, vfyCb, &vd);
+    rc = vd.rc = rpmvsVerify(vs, RPMSIG_VERIFIABLE_TYPE, vfyCb, &vd);
