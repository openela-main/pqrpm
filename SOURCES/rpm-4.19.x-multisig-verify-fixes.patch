+    if (pgpSignatureType(sinfo->sig) == PGPSIGTYPE_BINARY) {
+	res = rpmKeyringVerifySig3(keyring, sinfo->sig, sinfo->ctx,
+			NULL, &sinfo->lints);
+    }
     return res;
 }
 
diff --git a/lib/rpmvs.h b/lib/rpmvs.h
index 250d59ceb..7a6acb2ca 100644
--- a/lib/rpmvs.h
+++ b/lib/rpmvs.h
@@ -33,6 +33,7 @@ struct rpmsinfo_s {
