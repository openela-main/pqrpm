+    if ((vfylevel & RPMSIG_DIGEST_TYPE) && (verified[RPMSIG_DIGEST_TYPE] != range))
+	failed |= RPMSIG_DIGEST_TYPE;
+    if ((vfylevel & RPMSIG_SIGNATURE_TYPE) && (verified[RPMSIG_SIGNATURE_TYPE] != range))
