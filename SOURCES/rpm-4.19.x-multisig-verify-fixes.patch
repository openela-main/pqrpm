 	int strength = (sinfo->type | sinfo->strength);
@@ -568,22 +564,25 @@ int rpmvsVerify(struct rpmvs_s *sis, int type,
 	    cont = cb(sinfo, cbdata);
 
 	switch (sinfo->rc) {
-	case RPMRC_OK:
-	    success++;
-	    break;
 	case RPMRC_FAIL:
 	case RPMRC_NOKEY:
-	case RPMRC_NOTFOUND:
-	    failed++;
+	    failed |= sinfo->type;
