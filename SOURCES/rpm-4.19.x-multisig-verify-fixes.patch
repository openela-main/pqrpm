 	memset(sinfo, 0, sizeof(*sinfo));
     }
 }
@@ -589,6 +590,15 @@ int rpmvsVerify(struct rpmvs_s *sis, int type,
     return failed;
 }
 
+void rpmvsForeach(struct rpmvs_s *sis, rpmsinfoCb cb, void *cbdata)
+{
