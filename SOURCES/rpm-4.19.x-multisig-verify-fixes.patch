+    rpmvsForeach(vs, lintCb, &vd);
 
     if (!vd.verbose) {
 	if (vd.seen & RPMSIG_DIGEST_TYPE) {
diff --git a/lib/rpmvs.c b/lib/rpmvs.c
index 88a29c97e..763481386 100644
