+{
+    struct vfydata_s *vd = (struct vfydata_s *)cbdata;
+    if (vd->rc && sinfo->lints) {
+	char *msg = argvJoin(sinfo->lints, "\n");
+	rpmlog(RPMLOG_ERR, "%s\n", msg);
+	free(msg);
+    }
+    return 1;
+}
+
