diff --git a/lib/rpmvs.c b/lib/rpmvs.c
index 06aa73b7e..b0d2a784b 100644
--- a/lib/rpmvs.c
+++ b/lib/rpmvs.c
@@ -502,10 +502,10 @@ static const struct rpmsinfo_s *getAlt(const struct rpmvs_s *vs, const struct rp
 int rpmvsVerify(struct rpmvs_s *sis, int type,
 		       rpmsinfoCb cb, void *cbdata)
 {
-    int success = 0;
     int failed = 0;
     int cont = 1;
-    int range = 0, vfylevel = sis->vfylevel;
+    int vfylevel = sis->vfylevel;
